# Required. 32 random bytes, base64url-encoded (URL-safe, unpadded).
# Generate with:
#   openssl rand -base64 32 | tr '+/' '-_' | tr -d '='
# This same secret signs the splitup server's session JWTs and is consumed by
# PowerSync as the HS256 JWK — keep it confidential.
SPLITUP_SESSION_SECRET=replace-me

# Only required for the `sync` profile (PowerSync). Random string protecting
# the PowerSync management API.
#   openssl rand -base64 24
POWERSYNC_MANAGEMENT_TOKEN=replace-me

# Optional: if set, /fx/latest falls back to OpenExchangeRates when the cache misses.
OPEN_EXCHANGE_RATES_API_KEY=

# Optional: host ports. Override if your defaults are taken.
SPLITUP_PORT=8080
POWERSYNC_PORT=8081
POSTGRES_PORT=5432
