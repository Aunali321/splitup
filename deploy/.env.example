# Required. 32 random bytes, base64url-encoded (URL-safe, unpadded).
# Generate with:
#   openssl rand -base64 32 | tr '+/' '-_' | tr -d '='
# This same secret signs the splitup server's JWTs and is consumed by
# PowerSync as the HS256 JWK — keep it confidential.
SPLITUP_SESSION_SECRET=replace-me

# Required. Password for the app Postgres (used by the server and PowerSync).
#   openssl rand -base64 24
POSTGRES_PASSWORD=replace-me

# Only required for the `sync` profile (PowerSync). Random string protecting
# the PowerSync management API.
#   openssl rand -base64 24
POWERSYNC_MANAGEMENT_TOKEN=replace-me

# Optional: if set, /fx/latest serves rates refreshed from OpenExchangeRates
# twice a day (USD-based; cross pairs are derived). Without it the endpoint
# has no rate source and returns 404.
OPEN_EXCHANGE_RATES_API_KEY=

# Optional: set to true ONLY when a reverse proxy in front of the server
# overwrites X-Forwarded-For. It makes the auth rate limit key on the real
# client address; enabling it on a bare deployment lets clients spoof theirs.
SPLITUP_BEHIND_PROXY=false

# Optional: host ports. Override if your defaults are taken.
# Postgres binds to 127.0.0.1 only.
SPLITUP_PORT=8080
POWERSYNC_PORT=8081
POSTGRES_PORT=5432
